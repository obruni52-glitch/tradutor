<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão para desenhar a bolinha flutuante por cima dos jogos/apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Permissões de serviço em primeiro plano (compatível com Android 14/15) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    
    <!-- Permissão de vibração tátil ao tocar na bolinha -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Tradutor de Tela"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TradutorDeTela">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TradutorDeTela">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- O serviço que gerencia a bolinha flutuante e a captura de tela -->
        <service
            android:name=".FloatingService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
    </application>

</manifest>
